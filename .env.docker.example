# ShikariMCP Docker Compose Configuration
# Copy this file to .env before running docker compose.

# Required. Do not use a shared or default value.
SHIKARI_API_KEY=change-this-to-a-long-random-secret

# Host bind settings. Keep localhost for standalone local use.
SHIKARI_BIND_ADDR=127.0.0.1
SHIKARI_PORT=8080

# The Docker container runs HTTP locally for your MCP client.
SHIKARI_LOCAL_MODE=true

# Supported manifest-backed profile.
SHIKARI_TOOL_PROFILE=core

# Execution controls.
SHIKARI_TIMEOUT=300
SHIKARI_MAX_CONCURRENT=10
SHIKARI_MAX_OUTPUT_CHARS=50000

# Safety defaults.
SHIKARI_ENABLE_GENERATED_TOOLS=false
SHIKARI_ENABLE_EXPERIMENTAL_TOOLS=false
SHIKARI_REQUIRE_TOOL_DEPENDENCIES=false
SHIKARI_ENABLE_REMOTE_ACTIVE_TOOLS=false
SHIKARI_ENABLE_ACTIVE_TOOLS=false
SHIKARI_ENABLE_OFFENSIVE_TOOLS=false
SHIKARI_ENABLE_CREDENTIAL_TOOLS=false
SHIKARI_TARGET_ALLOWLIST=
SHIKARI_AUDIT_ENABLED=true
SHIKARI_LOG_LEVEL=INFO
