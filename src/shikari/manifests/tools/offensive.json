      "version_command": ["hydra", "-h"],
      "install": {"apt": ["hydra"]},
      "command_templates": {
        "safe": {"argv": ["hydra", "-L", "{users}", "-P", "{passwords}", "-t", "4", "{target}", "{service}"], "timeout": 1800, "output_format": "text"}
