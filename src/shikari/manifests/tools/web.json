{
  "schema_version": 1,
  "profile": "web",
  "description": "Web application testing profile for local-first crawling, fuzzing, TLS checks, and template scanning.",
  "tools": [
    {
      "id": "whatweb_scan",
      "display_name": "WhatWeb Scan",
      "binary": "whatweb",
      "category": "web_application",
      "quality": "verified",
      "scope": "local",
      "capabilities": [
        "active_network"
      ],
      "approval": "active_tools",
      "target_types": [
        "url",
        "host"
      ],
      "version_command": [
        "whatweb",
        "--version"
      ],
      "install": {
        "apt": [
          "whatweb"
        ]
      },
      "command_templates": {
        "safe": {
          "argv": [
            "whatweb",
            "{target}"
          ],
          "timeout": 300,
          "output_format": "text"
        }
      },
      "parser": "shikari.parsers.whatweb.parse_text"
    },
    {
      "id": "wafw00f_scan",
      "display_name": "Wafw00f WAF Detection",
      "binary": "wafw00f",
      "category": "web_application",
      "quality": "verified",
      "scope": "local",
      "capabilities": [
        "active_network"
      ],
      "approval": "active_tools",
      "target_types": [
        "url",
        "host"
      ],
      "version_command": [
        "wafw00f",
        "--version"
      ],
      "install": {
        "apt": [
          "wafw00f"
        ]
      },
      "command_templates": {
        "safe": {
          "argv": [
            "wafw00f",
            "-f",
            "json",
            "{target}"
          ],
          "timeout": 300,
          "output_format": "json"
        }
      },
      "parser": "shikari.parsers.wafw00f.parse_json"
    },
    {
      "id": "testssl_scan",
      "display_name": "testssl.sh Scan",
      "binary": "testssl.sh",
      "category": "web_application",
      "quality": "verified",
      "scope": "local",
      "capabilities": [
        "active_network"
      ],
      "approval": "active_tools",
      "target_types": [
        "host",
        "url"
      ],
      "version_command": [
        "testssl.sh",
        "--version"
      ],
      "install": {
        "apt": [
          "testssl.sh"
        ]
      },
      "command_templates": {
        "safe": {
          "argv": [
            "testssl.sh",
            "--jsonfile",
            "{output_file}",
            "{target}"
          ],
          "timeout": 900,
          "output_format": "json"
        }
      },
      "parser": null
    },
    {
      "id": "dalfox_scan",
      "display_name": "Dalfox XSS Scan",
      "binary": "dalfox",
      "category": "web_application",
      "quality": "verified",
      "scope": "local",
      "capabilities": [
        "vulnerability_scan",
        "active_network"
      ],
      "approval": "active_tools",
      "target_types": [
        "url"
      ],
      "version_command": [
        "dalfox",
        "version"
      ],
      "install": {
        "go": "github.com/hahwul/dalfox/v2@v2.12.0"
      },
      "command_templates": {
        "safe": {
          "argv": [
            "dalfox",
            "url",
            "{url}",
            "--format",
            "json",
            "--silence"
          ],
          "timeout": 900,
          "output_format": "json"
        }
      },
      "parser": "shikari.parsers.dalfox.parse_jsonl"
    },
    {
      "id": "arjun_scan",
      "display_name": "Arjun Parameter Discovery",
      "binary": "arjun",
      "category": "web_application",
      "quality": "verified",
      "scope": "local",
      "capabilities": [
        "active_network"
      ],
      "approval": "active_tools",
      "target_types": [
        "url"
      ],
      "version_command": [
        "arjun",
        "--version"
      ],
      "install": {
        "pipx": "arjun"
      },
      "command_templates": {
        "safe": {
          "argv": [
            "arjun",
            "-u",
            "{url}",
            "-oJ",
            "{output_file}"
          ],
          "timeout": 900,
          "output_format": "json"
        }
      },
      "parser": "shikari.parsers.arjun.parse_json"
    },
    {
      "id": "sslscan_scan",
      "display_name": "SSLScan",
      "binary": "sslscan",
      "category": "web_application",
      "quality": "verified",
      "scope": "local",
      "capabilities": [
        "active_network"
      ],
      "approval": "active_tools",
      "target_types": [
        "host"
      ],
      "version_command": [
        "sslscan",
        "--version"
      ],
      "install": {
        "apt": [
          "sslscan"
        ]
      },
      "command_templates": {
        "safe": {
          "argv": [
            "sslscan",
            "--xml=-",
            "{target}"
          ],
          "timeout": 300,
          "output_format": "xml"
        }
      },
      "parser": null
    },
    {
      "id": "tlsx_scan",
      "display_name": "TLSX Scan",
      "binary": "tlsx",
      "category": "web_application",
      "quality": "verified",
      "scope": "local",
      "capabilities": [
        "active_network"
      ],
      "approval": "active_tools",
      "target_types": [
        "host",
        "stdin_list"
      ],
      "version_command": [
        "tlsx",
        "-version"
      ],
      "install": {
        "go": "github.com/projectdiscovery/tlsx/cmd/tlsx@v1.2.2"
      },
      "command_templates": {
        "safe": {
          "argv": [
            "tlsx",
            "-json",
            "-silent"
          ],
          "stdin": "{targets}",
          "timeout": 300,
          "output_format": "jsonl"
        }
      },
      "parser": null
    }
  ]
}
