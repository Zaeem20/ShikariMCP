{
  "schema_version": 1,
  "profile": "osint",
  "description": "OSINT, SOCINT (social media intelligence), geosint, threat intelligence, and data-breach lookup tools. All tools query external APIs or public sources — no traffic reaches the target's own network — so they are passive and work in both stdio and remote HTTP modes unless marked local-only.",
  "tools": [
    {
      "id": "sherlock_username",
      "display_name": "Sherlock Username Search",
      "binary": "sherlock",
      "category": "osint",
      "quality": "verified",
      "scope": "both",
      "capabilities": ["passive_recon"],
      "approval": "none",
      "target_types": ["username"],
      "version_command": ["sherlock", "--help"],
      "install": {"pipx": "sherlock-project"},
      "command_templates": {
        "safe": {"argv": ["sherlock", "{username}", "--csv", "--timeout", "30", "--no-color", "--print-found"], "timeout": 300, "output_format": "text"}
      },
      "parser": "shikari.parsers.sherlock.parse_csv"
    },
