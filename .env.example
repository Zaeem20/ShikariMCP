# ShikariMCP Environment Configuration
# Copy this file to .env and configure

# Transport: stdio or streamable-http
SHIKARI_TRANSPORT=stdio

# HTTP Settings (only used when transport=streamable-http)
SHIKARI_HOST=127.0.0.1
SHIKARI_PORT=8080
SHIKARI_API_KEY=your-secret-api-key-here
SHIKARI_ALLOW_UNAUTHENTICATED_HTTP=false
SHIKARI_HTTP_JSON_RESPONSE=false
SHIKARI_HTTP_STATELESS=false
SHIKARI_HTTP_ALLOWED_HOSTS=
SHIKARI_HTTP_ALLOWED_ORIGINS=
SHIKARI_HTTP_EVENT_TTL=3600
SHIKARI_HTTP_RETRY_INTERVAL_MS=2000

# Scope: set to true if running HTTP locally (unlocks LOCAL tools over HTTP)
SHIKARI_LOCAL_MODE=false

# Execution
SHIKARI_TIMEOUT=300
SHIKARI_MAX_CONCURRENT=10
SHIKARI_MAX_OUTPUT_CHARS=50000
SHIKARI_MAX_PARSER_BYTES=10000000
SHIKARI_MAX_BACKGROUND_RUNS=100
SHIKARI_MAX_INPUT_CHARS=1000000
SHIKARI_MAX_TARGETS_PER_RUN=5000
SHIKARI_ARTIFACT_DIR=.shikari/artifacts
SHIKARI_DEFAULT_WORDLIST=/opt/wordlists/SecLists/Discovery/Web-Content/common.txt

# Production safety policy
SHIKARI_TOOL_PROFILE=core
SHIKARI_ENABLE_LEGACY_TOOLS=false
SHIKARI_ENABLE_GENERATED_TOOLS=false
SHIKARI_ENABLE_EXPERIMENTAL_TOOLS=false
SHIKARI_REQUIRE_TOOL_DEPENDENCIES=false
SHIKARI_ENABLE_REMOTE_ACTIVE_TOOLS=false
SHIKARI_ENABLE_ACTIVE_TOOLS=false
SHIKARI_ENABLE_OFFENSIVE_TOOLS=false
SHIKARI_ENABLE_CREDENTIAL_TOOLS=false
SHIKARI_TARGET_ALLOWLIST=
SHIKARI_AUDIT_ENABLED=true
SHIKARI_AUDIT_LOG_PATH=.shikari/audit.jsonl

# Logging
SHIKARI_LOG_LEVEL=INFO
